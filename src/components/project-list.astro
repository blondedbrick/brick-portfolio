---
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<ul class="grid grid-cols-1 not-prose px-1">
  {projects.map((project) => (
    <li class="grid grid-cols-1 md:grid-cols-7 min-h-fit border-x border-t last:border-b border-primary-300 p-2 Card group hover:bg-white">
      
      <div class="h-full w-full aspect-5/3.5 bg-primary-200 p-10 md:col-span-4 flex items-center rounded">
          <img 
        class="object-contain rounded-lg group-hover:shadow-lg group-hover:outline group-hover:outline-primary-600/25"
        src={project.data.image} 
        alt={project.data.image_alt}
        loading="lazy"
      />

      </div>
    
      
      <div class="p-4 sm:p-6 md:p-8 lg:p-10 flex flex-col gap-4 md:col-span-3">

        <h3 class="text-2xl md:text-3xl font-medium text-primary-900 max-md:pr-4">
        {project.data.link ? (
          <a href={project.data.link} target="_blank" class="Card-Primary-Action">{project.data.title} <span class="text-primary-600 text-xl md:text-2xl" aria-label="Opens in a new window">↗</span></a>
        ) : (
          project.data.title
        )}
      </h3>

      <p class="font-light text-primary-600 text-base md:text-lg">
        {project.data.role}
      </p>

      <ul class="flex gap-2 flex-wrap">
        {project.data.tags.map((tag) => (
          <li class="font-mono text-sm md:text-base border px-2 rounded border-primary-300 text-primary-600">
            {tag}
          </li>
        ))}
      </ul>
        
      </div>
    </li>
  ))}
</ul>