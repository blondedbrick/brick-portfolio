---
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<ul class="grid grid-cols-1 gap-8 not-prose">
  {projects.map((project) => (
    <li class="grid grid-cols-2 min-h-fit">
      <img 
      class="aspect-square h-full w-full object-cover rounded"
        src={project.data.image} 
        alt={project.data.image_alt} 
      />
      
      <div class="p-8">

        <h3>
        {project.data.link ? (
          <a href={project.data.link}>{project.data.title}</a>
        ) : (
          project.data.title
        )}
      </h3>

      <p>
        {project.data.client} — {project.data.role}
      </p>

      <ul>
        {project.data.tags.map((tag) => (
          <li>
            {tag}
          </li>
        ))}
      </ul>
        
      </div>
    </li>
  ))}
</ul>