<header class="py-4 border-b border-b-primary-200 relative">
    <nav class="flex justify-between items-center container">
         <div class="flex items-center gap-3 Card group">
            <div class="size-13 bg-primary-800 border-2 border-primary-700 rounded-2xl text-white text-xl flex justify-center items-center font-mono group-hover:shadow-xl group-hover:border-primary-500">`b`</div>
            <a class="leading-tight text-lg font-normal Card-Primary-Action font-serif italic" href="/">Brick<br>Adamos</a>
        </div>

        <!-- Desktop Navigation Links (Hidden on sm and below) -->
        <ul class="hidden sm:flex gap-8 text-lg text-primary-600 font-light">
            <li><a href="#work" class="hover:text-primary-900 transition-colors">Work ↓</a></li>
            <li><a href="#about" class="hover:text-primary-900 transition-colors">About ↓</a></li>
            <li><a href="#contact" class="hover:text-primary-900 transition-colors">Contact ↓</a></li>
        </ul>

        <button 
            id="menu-btn" 
            class="sm:hidden p-2 text-primary-800 hover:cursor-pointer hover:bg-primary-100 border border-primary-300/0 hover:border-primary-300 rounded-xl"
            aria-label="Toggle menu"
        >
            <!-- Hamburger Icon -->
            <svg id="icon-open" class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <!-- Close (X) Icon (Hidden by default) -->
            <svg id="icon-close" class="w-10 h-10 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </nav>

    <!-- Mobile Dropdown / Slide-down Menu (Positioned relative to <header>) -->
    <div 
        id="mobile-menu" 
        class="absolute top-full left-1/2 -translate-x-1/2 bg-surface border border-primary-300 shadow-lg sm:hidden z-50 hidden bg-primary-50 w-full p-2"
    >
        <ul class="flex flex-col text-lg text-primary-600 font-light text-center *:py-4 *:not-last:border-b *:not-last:border-primary-100">
            <li><a href="#work" class="mobile-link block hover:text-primary-900">Work ↓</a></li>
            <li><a href="#about" class="mobile-link block hover:text-primary-900">About ↓</a></li>
            <li><a href="#contact" class="mobile-link block hover:text-primary-900">Contact ↓</a></li>
        </ul>
    </div>
</header>

<script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    function toggleMenu() {
        const isOpen = mobileMenu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden', !isOpen);
        iconClose.classList.toggle('hidden', isOpen);
    }

    menuBtn?.addEventListener('click', toggleMenu);

    // Auto-close menu when clicking any mobile navigation link
    mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
            iconOpen.classList.remove('hidden');
            iconClose.classList.add('hidden');
        });
    });
</script>