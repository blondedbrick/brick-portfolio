---
import '../styles/global.css';
import ProjectList from '../components/project-list.astro';
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Brick Adamos</title>
    </head>
    <body class="">

        <header class="py-2 border-b border-b-neutral-500">
			<nav class="flex justify-between items-center container">
				 <div class="size-16 bg-neutral-900 rounded-xl text-white text-3xl flex justify-center items-center">`B`</div>

				<ul class="flex gap-8 text-xl">
					<li><a href="#work">Work</a></li>
					<li><a href="#about">About</a></li>
					<li><a href="#contact">Contact</a></li>
				</ul>
			</nav>
        </header>

		<!-- Hero Section -->
		<div class="min-h-180 border-b border-b-neutral-200 flex justify-center items-center text-center">

					<div class="flex flex-col items-center max-w-180 gap-4 pb-12">
					<h1 class="text-8xl font-normal mb-4">Brick can make things click.</h1>
					<p class="text-3xl mb-4 font-light">Hello! I'm a Hybrid Web Developer and Designer based in Winnipeg, Manitoba. I specialize in creating meaningful user centric digital experiences.</p>
					<a href="mailto:brickadamosamador@gmail.com" class="text-2xl px-6 py-3 rounded-xl border-t-4 border-neutral-600 bg-neutral-800 text-neutral-50 font-light shadow-lg hover:underline">Let's Connect</a>
					</div>
			      


		</div>


            <h2 id="work">Professional Work</h2>
            <!-- Dynamic Content Collection Loop -->
            <ProjectList />

            <h2 id="about">About Me</h2>
            <h3>Hi! I'm Brick Adamos, a Hybrid Web Developer and Designer.</h3>
            <p>I have 3+ years of experience in the industry where I specialize in building accessible, user-centric product solutions.

            My approach balances deep user empathy with practical execution. I do my best to ensure every solution is intuitively designed, technically grounded, and built to ship on time.

            When I'm not in front of a computer, you can find me running a half marathon, doing street photography, or spectacularly failing in the kitchen.</p>

            <h2 id="contact">Contact</h2>
            <h3>All journeys start with the first step.</h3>
            <p>Have a role in mind, a project, or anything you'd like to share? I'd love to hear about it!</p>

            <a href="mailto:brickadamosamador@gmail.com">Let's Connect</a>

        <footer>
            <p>© 2026 Brick Adamos · Made with AstroJS + Tailwind</p>
        </footer>
    </body>
</html>