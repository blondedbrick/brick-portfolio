---
import '../styles/global.css';
import ProjectList from '../components/project-list.astro';
import NavBar from '../components/nav-bar.astro';

const currentYear = new Date().getFullYear();
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Brick Adamos</title>
    </head>
    <body class="">

        <NavBar />

		<!-- Hero Section -->
		<section class="min-h-180 flex justify-center items-center text-center">

					<div class="flex flex-col items-center max-w-160 gap-4 pb-12 px-12">
					<h1 class="text-5xl md:text-6xl lg:text-7xl mb-2 md:mb-4 font-medium">Brick can make<br>things click.</h1>
					<p class="text-xl md:text-2xl mb-4 font-light text-primary-700">👋 Mabuting Araw / Good Day! I'm a Hybrid Web Developer and Designer based in Winnipeg, Manitoba. I specialize in creating meaningful user centric digital experiences.</p>
					<a href="mailto:brickadamosamador@gmail.com" class="btn">Let's Connect</a>
					</div>
			      


        </section>


        <!-- Work section -->

        <section class="section-styling">

            <div class="container">
            
            <h2 id="work" class="not-prose section-heading">Professional Work</h2>

            <ProjectList />

            </div>

        </section>


        <!-- About section -->
        <section class="section-styling">

            <div class="container">

                <h2 id="about" class="not-prose section-heading">About Me</h2>

                <div class="content">
                <img class="size-36 bg-primary-500 rounded-full not-prose contrast-110" src="src/media/images/brick-headshot.webp" alt="Brick Adamos" />
                <h3>Hi! I'm Brick Adamos, a Hybrid Web Developer and Designer.</h3>
                <p>I have 3+ years of experience in the industry where I specialize in building accessible, user-centric product solutions.

                My approach balances deep user empathy with practical execution. I do my best to ensure every solution is intuitively designed, technically grounded, and built to ship on time.

                When I'm not in front of a computer, you can find me running a half marathon, doing street photography, or spectacularly failing in the kitchen.</p>

                <a class="btn not-prose" href="https://www.linkedin.com/in/brick-adamos" target="_blank">Linkedin Profile</a>
                </div>
            
            </div>

        </section>


        <!-- contact section -->
        
        <section class="section-styling pb-20">

            <div class="container">

                    <h2 id="contact" class="not-prose section-heading">Contact</h2>

                    <div class="content">
                    <h3>Say Hi!</h3>
                    <p>Have a role in mind, a project, or anything you'd like to share? I'd love to hear about it!</p>
                    <a href="mailto:brickadamosamador@gmail.com" class="btn not-prose">Let's Connect</a>
            </div>

            </div>


        </section>


        <footer class="p-4 text-center border-t border-t-primary-200 text-lg font-light">
            <p class="text-primary-700">© {currentYear} Brick Adamos · Made with AstroJS + Tailwind</p>
        </footer>
    </body>
</html>